008,5,8]]},"ISBN":["9780199536245","9780191920561"],"references-count":0,"URL":"https:\/\/doi.org\/10.1093\/owc\/9780199536245.003.0006","published":{"date-parts":[[2008,5,8]]}},{"indexed":{"date-parts":[[2023,4,20]],"date-time":"2023-04-20T04:21:11Z","timestamp":1681964471523},"reference-count":0,"publisher":"JSTOR","issue":"2","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["The American Historical Review"],"published-print":{"date-parts":[[1991,4]]},"DOI":"10.2307\/2163240","type":"journal-article","created":{"date-parts":[[2006,4,20]],"date-time":"2006-04-20T17:06:02Z","timestamp":1145552762000},"page":"487","source":"Crossref","is-referenced-by-count":0,"title":["Hellenistic and Roman Sparta: A Tale of Two Cities."],"prefix":"10.2307","volume":"96","author":[{"given":"Charles D.","family":"Hamilton","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Paul","family":"Cartledge","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Antony","family":"Spawforth","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"1121","container-title":["The American Historical Review"],"deposited":{"date-parts":[[2023,4,19]],"date-time":"2023-04-19T20:00:57Z","timestamp":1681934457000},"score":27.947601,"resource":{"primary":{"URL":"https:\/\/www.jstor.org\/stable\/10.2307\/2163240?origin=crossref"}},"issued":{"date-parts":[[1991,4]]},"references-count":0,"journal-issue":{"issue":"2","published-print":{"date-parts":[[1991,4]]}},"URL":"https:\/\/doi.org\/10.2307\/2163240","ISSN":["0002-8762"],"issn-type":[{"value":"0002-8762","type":"print"}],"published":{"date-parts":[[1991,4]]}},{"indexed":{"date-parts":[[2025,10,30]],"date-time":"2025-10-30T11:28:19Z","timestamp":1761823699745},"reference-count":15,"publisher":"Cambridge University Press (CUP)","issue":"3","license":[{"start":{"date-parts":[[2014,12,2]],"date-time":"2014-12-02T00:00:00Z","timestamp":1417478400000},"content-version":"unspecified","delay-in-days":2345,"URL":"https:\/\/www.cambridge.org\/core\/terms"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Can. j. neurol. sci."],"published-print":{"date-parts":[[2008,7]]},"abstract":"<jats:title><jats:bold>ABSTRACT:<\/jats:bold><\/jats:title><jats:sec id=\"S031716710000888X_abs1\"><jats:title><jats:bold><jats:italic>Introduction:<\/jats:italic><\/jats:bold><\/jats:title><jats:p>As governments struggle with increasing demand for accountability within the Canadian Health Care System and set wait-time standards, it is important to objectify data to allow a true understanding of present limitations and to facilitate comparisons to other systems. The purpose of this study was to compare wait list times for a cohort of patients requiring spinal surgery in Calgary, Alberta to a similar cohort in Sydney, Australia.<\/jats:p><\/jats:sec><jats:sec id=\"S031716710000888X_abs2\"><jats:title><jats:bold><jats:italic>Methods:<\/jats:italic><\/jats:bold><\/jats:title><jats:p>From January 1 until June 30, 2006 all outpatients admitted for spinal surgery to the Foothills Hospital were identified by the surgeons\u2019 office. Two time periods were quantified from their charts: (1) time from referral to surgical consultation; and (2) time from surgical consultation to operative intervention. From July 1 until December 31, 2006 patients were similarly identified through Neurosurgical offices at the Prince of Wales Public and Private Hospitals in Sydney, Australia.<\/jats:p><\/jats:sec><jats:sec id=\"S031716710000888X_abs3\"><jats:title><jats:bold><jats:italic>Results:<\/jats:italic><\/jats:bold><\/jats:title><jats:p>Four hundred ninety-one surgical patients were captured during the six month period in Calgary and 155 patients during the subsequent six months in Sydney. The majority of patients in Sydney were treated in the Private Health Care system. Public patients in Sydney have access to a surgical consultant twice as fast as public patients in Calgary while private patients have access ten times faster. Access to operating room time within the public system is a rate limiting step in both countries. However, Sydney private patients receive their surgery four times faster than Calgary patients.<\/jats:p><\/jats:sec><jats:sec id=\"S031716710000888X_abs4\"><jats:title><jats:bold><jats:italic>Conclusions:<\/jats:italic><\/jats:bold><\/jats:title><jats:p>Compared to Calgary, access to specialized spine care in Sydney appears more efficient not only in the Private but also the Public Health Care System. Part of this efficiency may arise from offloading from the public into the private system. Solutions proposed to reduce wait list times should consider benefits of a Private Health Care System.<\/jats:p><\/jats:sec>","DOI":"10.1017\/s031716710000888x","type":"journal-article","created":{"date-parts":[[2014,12,12]],"date-time":"2014-12-12T10:17:13Z","timestamp":1418379433000},"page":"308-313","source":"Crossref","is-referenced-by-count":8,"title":["Access to Spine Care: A Tale of Two Cities"],"prefix":"10.1017","volume":"35","author":[{"given":"R. John","family":"Hurlbert","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Ralph","family":"Mobbs","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Charles","family":"Teo","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"56","published-online":{"date-parts":[[2014,12,2]]},"reference":[{"key":"S031716710000888X_ref004","unstructured":"Australian Bureau of Statistics 2006. www.abs.gov.au\/AUSSTATS"},{"key":"S031716710000888X_ref001","first-page":"235","article-title":"Published by the Council of the College of Physicians and Surgeons","year":"2006","journal-title":"Province of Alberta"},{"key":"S03171