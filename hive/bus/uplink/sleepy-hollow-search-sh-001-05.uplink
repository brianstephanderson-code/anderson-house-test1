PAYLOAD={"batch_id":"sleepy-hollow-research-001","job_id":"SH-001-05","term":"Revolutionary War","finding":"Irving's Hessian reference needs only compact context: Britain employed German auxiliary troops, commonly called Hessians, during the American Revolution; large British-Hessian forces operated in New York in 1776. The story itself deliberately leaves the trooper's battle unnamed, so a reader aid should not silently turn a plausible historical inspiration into a documented identity.","source_doors":[{"door":"primary-text","source":"The Legend of Sleepy Hollow text","evidence":"Irving says 'some nameless battle during the Revolutionary War' and frames the Hessian identity as local report ('It is said by some')."},{"door":"official-history","source":"U.S. National Park Service — The Hessians","evidence":"German auxiliary troops served with British forces; Hessian troops participated in the 1776 New York campaign."},{"door":"institutional-history","source":"Museum of the American Revolution — Hessians","evidence":"Britain hired roughly 30,000 German soldiers during 1776-1783; 'Hessian' is a collective historical label."},{"door":"contradiction/overclaim-check","source":"Washington Irving Society / later historical discussions","evidence":"Some later accounts connect the fictional horseman to a specific decapitation event; this is useful as a hypothesis trail, not enough to overwrite Irving's deliberately unnamed battle as established fact."}],"search_pattern":{"name":"MINIMUM-CONTEXT BOUNDARY SEARCH","function":"For a historical allusion in fiction, search outward only until the minimum facts needed for comprehension are verified, then run an overclaim/identity check before adding detail.","steps":["anchor exact wording in primary text","identify the minimum comprehension hole","verify only those facts through official/institutional history","search for later specific-identification claims","label hypothesis versus established fact","stop when reader comprehension is satisfied"],"reusable":true},"warehouse_candidate":true}
